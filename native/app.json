{
  "expo": {
    "name": "Radio Star",
    "slug": "star-cast",
    "version": "1.0.0",
    "icon": "./assets/radio-star-icon.png",
    "scheme": "starcast",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "app.radiostar.ios",
      "buildNumber": "7",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/radio-star-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#171320"
        }
      ],
      "expo-secure-store",
      "expo-iap"
    ],
    "extra": {
      "starCastApiBaseUrl": "https://d3ri12f40b85i3.cloudfront.net",
      "eas": {
        "projectId": "249fb010-2c52-4be5-a7cf-e08b25f89cbe"
      }
    },
    "owner": "radiostar"
  }
}
