#!/bin/bash
set -euo pipefail
umask 077
dnf install -y tar gzip xz logrotate amazon-cloudwatch-agent
mkdir -p /opt/starcast/app /var/lib/starcast /var/log/starcast
id starcast >/dev/null 2>&1 || useradd --system --home /var/lib/starcast --shell /sbin/nologin starcast
cd /opt/starcast
curl -fsSLO https://nodejs.org/dist/v24.22.0/node-v24.22.0-linux-x64.tar.xz
curl -fsSLO https://nodejs.org/dist/v24.22.0/SHASUMS256.txt
grep ' node-v24.22.0-linux-x64.tar.xz$' SHASUMS256.txt | sha256sum -c -
tar -xJf node-v24.22.0-linux-x64.tar.xz
ln -sfn /opt/starcast/node-v24.22.0-linux-x64/bin/node /usr/local/bin/node
ln -sfn /opt/starcast/node-v24.22.0-linux-x64/bin/npm /usr/local/bin/npm
aws s3 cp s3://${bucket}/${release_key} /opt/starcast/release.tar.gz --region eu-west-2 --only-show-errors
echo '${release_sha}  /opt/starcast/release.tar.gz' | sha256sum -c -
tar -xzf /opt/starcast/release.tar.gz -C /opt/starcast/app
cd /opt/starcast/app
npm ci --omit=dev --no-audit --no-fund
cp scripts/cloud/logrotate.conf /etc/logrotate.d/starcast
chmod 644 /etc/logrotate.d/starcast
if [ ! -f /var/lib/starcast/backend.sqlite ]; then
  aws s3 cp s3://${bucket}/seed/initial.sqlite /var/lib/starcast/backend.sqlite --region eu-west-2 --only-show-errors
fi
chown -R starcast:starcast /var/lib/starcast /var/log/starcast
STARCAST_RELEASE_SHA="${release_sha}" node --input-type=module -e 'import {writeFileSync} from "node:fs"; writeFileSync("/var/lib/starcast/release.json", JSON.stringify({releaseSha:process.env.STARCAST_RELEASE_SHA,previousReleaseSha:null,deployedAt:new Date().toISOString(),rollbackAvailable:false})+"\\n",{mode:0o600});'
chown starcast:starcast /var/lib/starcast/release.json
chmod 755 /opt/starcast /opt/starcast/app
chmod -R a+rX /opt/starcast/app /opt/starcast/node-v24.22.0-linux-x64
cat >/etc/systemd/system/starcast.service <<'UNIT'
[Unit]
Description=Star Cast private Phase 1 backend
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=starcast
Group=starcast
WorkingDirectory=/opt/starcast/app
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=AWS_REGION=eu-west-2
Environment=STARCAST_SECRET_ARN=${secret_arn}
Environment=STARCAST_DATA_FILE=/var/lib/starcast/backend.sqlite
Environment=STARCAST_BACKUP_BUCKET=${bucket}
Environment=STARCAST_PROCESSING_QUEUE_URL=${processing_queue_url}
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/local/bin/node scripts/cloud/server.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/starcast /var/log/starcast
UMask=0077
StandardOutput=append:/var/log/starcast/backend.log
StandardError=append:/var/log/starcast/backend.log
[Install]
WantedBy=multi-user.target
UNIT
cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'LOGS'
{"agent":{"run_as_user":"root"},"logs":{"logs_collected":{"files":{"collect_list":[{"file_path":"/var/log/starcast/backend.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}","timezone":"UTC"}]}},"force_flush_interval":15}}
LOGS
systemctl daemon-reload
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s
systemctl enable --now starcast
